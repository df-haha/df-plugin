{
  "description": "daily-agenda hooks。(1) LINE guard：直接呼叫 LINE 送出類工具一律擋下（行事曆不經這個 hook）。(2) PreToolUse：讀到第三方原文（runs/、raw 子指令）時記錄標記，不擋任何工具。(3) PostToolUse + PostToolUseFailure：輸出含 raw sentinel 時記錄標記，不擋任何工具。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "send_message_auto|send_message_manual|send_file_manual|stage_line_reply|stage_line_forward|prepare_line_forward|confirm_line_forward|mcp__.*line.*__(?:send_|stage_|prepare_line_forward|confirm_line_forward)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lock.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-lock.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-lock.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
