{
  "description": "daily-agenda 縱深防護。(1) LINE guard。(2) PreToolUse taint lock：command-form + path-reference。(3) PostToolUse + PostToolUseFailure：sentinel + protected-path 偵測。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "send_message_auto|send_message_manual|send_file_manual|stage_line_reply|stage_line_forward|prepare_line_forward|confirm_line_forward|mcp__.*line.*__(?:send_|stage_|prepare_line_forward|confirm_line_forward)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lock.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-lock.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Read|Grep|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-lock.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
