{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/pilotfish/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "job_id", "role", "base_sha",
    "worktree_head_sha", "status", "summary", "changed_paths", "commands",
    "evidence", "blocking_reason"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "role": {
      "type": "string",
      "enum": ["scout", "executor", "verifier"]
    },
    "base_sha": {"$ref": "#/$defs/sha"},
    "worktree_head_sha": {"$ref": "#/$defs/sha"},
    "status": {
      "type": "string",
      "enum": [
        "DONE", "NEEDS_CONTEXT", "BLOCKED", "CONFIRMED", "REFUTED",
        "NEEDS_WRITABLE_VERIFICATION"
      ]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 16384},
    "changed_paths": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/command_result"}
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1, "maxLength": 8192}
    },
    "blocking_reason": {"type": ["string", "null"], "maxLength": 16384}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "exit_code"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "exit_code": {"type": "integer"}
      }
    }
  }
}
