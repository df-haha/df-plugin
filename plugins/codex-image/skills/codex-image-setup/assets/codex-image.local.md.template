---
# codex-image config — generated by codex-image-setup
# 此檔由 setup skill 自動產生，手動編輯 frontmatter 欄位會在下次 setup 時被覆寫。
# 使用者筆記請寫在下方 user-notes 區塊內（跨重跑保留）。

# --- 偵測類欄位（setup 自動填寫）---
platform: unknown
is_wsl: unknown
codex_cli_version: unknown
codex_logged_in: unknown
image_generation_feature: unknown
detected_dispatch_model: unknown
detected_dispatch_effort: unknown
python_cmd: unknown
pillow_available: unknown
openai_api_key_present: unknown    # 只記錄是否存在，絕不記錄 key 本身
network_access_configured: unknown
smoke_status: unknown
last_smoke_at: ""

# --- 使用者偏好欄位 ---
default_quality: "high"
default_size: "auto"
default_output_dir: "./assets/generated/"
# deny_write_paths 平台相關：WSL 預設 ["/mnt/"]，win32 / linux / darwin 預設 []；由 defaultDenyWritePaths() 決定
deny_write_paths: ["/mnt/"]
allow_cli_fallback: "no"
timeout_seconds: 240
max_parallel: 3
override_dispatch_model: ""
quality_hint_mode: "natural-language"

# --- Meta 欄位 ---
schema_version: "1"
setup_version: ""
setup_at: ""
